---
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import SocialLinks from '@components/SocialLinks.astro';
import HCard from '@components/H-Card.astro';
import PostsColumns from '@components/PostsColumns.astro';
import Popular from '@components/Popular.astro';
import RecentPosts from '@components/RecentPosts.astro';
import RecentNotes from '@components/RecentNotes.astro';
import RecentLinks from '@components/RecentLinks.astro';
import RecentLifestream from '@components/RecentLifestream.astro';
import LastPlayed from '@components/LastPlayed.astro';
import Buttons from '@components/88x31.astro';
import ProfilePageSchema from '@components/ProfilePageSchema.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '@consts';
---

<style scoped>
  .intro {
    margin-bottom: 2em;
  }
  .about {
    text-shadow: 2px 3px 2px var(--accent);
    font-size: 3.25em;
    font-weight: 700;
    letter-spacing: -1px;
    word-spacing: -6px;
    line-height: 1;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 0.5em;
  }
  .intro-text {
    margin: 1em auto;
    text-wrap: pretty;
  }
  .column-item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em;
    margin: 2em auto 0 auto;
  }
  @media screen and (max-width: 992px) {
    .column-item {
      display: flex;
      flex-direction: column;
      gap: 1em; /* match whatever spacing PostsColumns normally gives between items */
    }
    .column-item > :global(*) {
      display: contents;
    }
    .col-popular { order: 1; }
    .col-posts   { order: 2; }
    .col-notes   { order: 3; }
    .col-links   { order: 4; }
    .col-played  { order: 5; }
  }
  @media screen and (max-width: 720px) {
    .about {
      font-size: 1.725em;
    }
  }
</style>

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <ProfilePageSchema slot="head" />
  <section class="intro">
    <HCard hidden />
    <h1 class="sub-font mb0 w9">Hello World</h1>
    <hr />
    <p class="intro-text">
      I'm Ariel, a hobbyist and tech enthusiast that writes about self-hosting,
      web development, Linux, and related topics. If you're looking for the main
      attraction, that would be <a href="/blog" data-umami-event="intro-blog"
        >the blog</a
      > where I write how-to guides. You can see <a href="#latest">latest</a> and <a href="#popular">popular</a> posts below, or
      you can <a href="/blog/random">go to a random post</a>.
    </p>
    <p class="intro-text">
      If you're interested, you can <a
        href="/colophon"
        data-umami-event="intro-colophon">read about how I make this site</a
      > or <a href="/stats" data-umami-event="intro-stats"
        >see statistics about the content</a
      >. There's some other personal stuff around here, like my <a href="#lifestream">lifestream</a> (that's what I call my media log) and <a href="/self-hosted">self-hosted setup</a>, feel free to <a href="/explore">explore</a> the site. I also have a separate <a
        href="https://ariel.lol"
        target="_blank"
        rel="noreferrer noopener"
        data-umami-event="microblog">microblog</a
      > for random short-form non-tech <span class="i">(shit-)</span>posting
      once in a blue moon, which I <a href="#notes">syndicate here as notes</a>.
    </p>
    <SocialLinks />
    <div class="column-item">
      <PostsColumns>
        <div class="col-popular" id="popular"><Popular class="pop-index" /></div>
        <div class="col-notes" id="notes"><RecentNotes /></div>
      </PostsColumns>
      <PostsColumns>
        <div class="col-posts" id="latest"><RecentPosts /></div>
        <div class="col-links"><RecentLinks /></div>
        <div class="col-played"><LastPlayed /></div>
      </PostsColumns>
    </div>
    <div id="lifestream"><RecentLifestream/></div>
    <div id="buttons"><Buttons /></div>
  </section>
</BaseLayout>
