---
import FormattedDate from './FormattedDate.astro';
import { getFirehose } from '@utils/collections';
import type { FirehoseEntry } from '@utils/collections';
import More from '@icons/arrow-right.svg';

const DEFAULT_EXCLUDED_TYPES: string[] = ['blog', 'lifestream', 'note', 'link'];
const DEFAULT_LIMIT = 5;

type Props = {
  exclude?: string[];
  limit?: number;
};

const { exclude = DEFAULT_EXCLUDED_TYPES, limit = DEFAULT_LIMIT } =
  Astro.props;

const time = (entry: FirehoseEntry) =>
  new Date(entry.updated ?? entry.date).getTime();

const recentUpdates = (await getFirehose())
  .filter((entry: FirehoseEntry) => !exclude.includes(entry.type))
  .sort((a: FirehoseEntry, b: FirehoseEntry) => time(b) - time(a))
  .slice(0, limit);
---

<style scoped>
  section {
    margin: 0 auto;
    padding: 0;
  }
  h2 {
    margin-bottom: 0.3em;
    font-family: var(--sub-font);
    font-weight: 900;
  }
  p {
    margin: 0;
  }
  .info {
    display: flex;
    place-items: center;
    margin: 0;
    padding: 0;
    gap: 0.5em;
  }
  .updated-label {
    font-size: 0.875em;
    font-family: var(--sub-font);
    font-weight: 700;
    color: var(--other);
  }
  .tag {
    display: flex;
    place-items: center;
    margin: 0.25em 0;
  }
  .container {
    background-color: var(--blockquote);
    border-radius: 0.5em;
    margin: 0.5em auto 0 auto;
    padding: 1em 1.5em 1.5em 1.5em;
  }
  .list {
    display: flex;
    flex-direction: column;
    margin: 0 auto 1em auto;
    padding-bottom: 0.5em;
    line-height: 1.3;
    border-bottom: 4px dotted transparent;
  }
  .updates-title {
    display: inline-flex;
    flex-direction: row;
    margin: 0 auto;
    font-weight: bold;
    line-height: 1.2;
    color: var(--emphasis);
  }
  .type-label {
    display: block;
    font-family: var(--sub-font);
    font-size: 0.675em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--secondary);
  }
  .more {
    display: flex;
    font-family: var(--sub-font);
    font-weight: 800;
    justify-content: end;
    margin: 0 -1em -1.5em 0;
    padding: 0 0 0.25em 0;
  }
  .more svg {
    display: inline-flex;
    place-content: center;
    margin: 4px 0 -3px 0;
    padding: 0;
    filter: var(--svg2);
    transition: 0.15s ease-in-out;
  }
  .more a {
    color: var(--secondary);
  }
  .more a:hover {
    color: var(--foot-link);
  }
  .more a:hover svg {
    filter: var(--foot-svg);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: translateX(4px);
  }

  @media (hover: hover) {
    .list:hover {
      padding-bottom: 0.5em;
      border-bottom: 4px dotted var(--hover);
      transition: all 0.25s ease-out;
    }
    .list:hover .updates-title {
      color: var(--hover);
      transition: all 0.25s ease-out;
    }
    .list:hover .btn {
      box-shadow: -4px -4px 0 #000;
      transform: translate(4px, 4px);
      transition: all 0.1s ease-out;
      outline-offset: 1px;
    }
  }

  @media screen and (max-width: 1245px) {
    .more {
      margin: -0.25em -1.25em -0.5em 0;
    }
  }

  @media screen and (max-width: 667px) {
    .container {
      padding: 0.6em 1em 0.25em 1em;
    }
    h2 {
      margin-top: -0.5em;
    }
    .updates-title {
      font-size: 0.875em;
    }
    .more {
      margin: -0.25em 0 0 0;
      padding: 0;
    }
    .info {
      display: block;
      margin: 0.5em 0 0.25em 0;
    }
    .tag {
      display: block;
      margin: 0.1em 0 -0.2em 0;
    }
    .tag > .btn {
      margin-bottom: 0.2em;
    }
    .list {
      transition: none;
      border-bottom: 0;
      margin: 0 0 0.5em 0;
    }
    .list:hover,
    .list:hover .updates-title {
      transition: none;
      border-bottom: 0;
    }
  }
</style>

<section class="h-feed">
  <h2 class="p-name">Recently Updated</h2>
  <div class="container">
    {
      recentUpdates.map((entry: FirehoseEntry) => {
        const href = entry.slug ?? entry.url ?? '#';
        const isExternal = !entry.slug;
        return (
          <div class="h-entry list">
            <a
              class="u-url"
              href={href}
              {...(isExternal
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : { rel: 'prefetch-intent' })}
            >
              <span class="type-label">{entry.type}</span>
              <p class="p-name updates-title">{entry.title ?? entry.type}</p>
              {entry.tags && entry.tags.length > 0 && (
                <span class="tag">
                  {entry.tags.map((tag: string) => (
                    <span class="btn">{tag}</span>
                  ))}
                </span>
              )}
              <p class="info">
                {entry.updated && <span class="updated-label">Updated</span>}
                <FormattedDate
                  class="dt-published"
                  date={entry.updated ?? entry.date}
                  monthFormat="short"
                />
              </p>
            </a>
          </div>
        );
      })
    }
    <span class="more">
      <a href="/all" rel="prefetch-intent archives"
        >Everything <More height={24} width={24} /></a
      >
    </span>
  </div>
</section>