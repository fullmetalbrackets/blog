---
import { getSortedTags } from '@utils/collections';

const TOP_TAG_LIMIT = 7;

const isLimited = Number.isFinite(TOP_TAG_LIMIT);

const tags = (await getSortedTags())
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
  .slice(0, TOP_TAG_LIMIT)
  .sort((a, b) =>
    isLimited ? b.count - a.count || a.tag.localeCompare(b.tag) : a.tag.localeCompare(b.tag)
  );
---

<style scoped>
  section {
    margin: 0 auto 0.5em auto;
    padding: 0;
  }
  h2 {
    font-family: var(--sub-font);
    font-weight: 900;
  }
  ul {
    background-color: var(--blockquote);
    border-radius: 0.5em;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    list-style-type: none;
    margin: 0.5em auto 0 auto;
    padding: 1.25em 1.5em;
  }
  li {
    margin: 0.25em;
  }
  .label a {
    color: #000;
  }
  .count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25em;
    height: 1rem;
    padding: 1px 0 0 0;
    margin: 0 auto;
    background: rgba(0, 0, 0, 0.15);
    border-radius: 9999px;
    font-family: var(--main-font);
    font-size: 0.675em;
  }
  button a {
    display: flex;
    place-items: center;
    gap: 0.25em;
  }
  p {
    margin-bottom: 2em;
  }
  @media screen and (max-width: 755px) {
    ul {
      padding: 1em;
    }
  }
</style>

<section>
  <h2>Top Categories</h2>
  <ul>
    {
      tags.map(({ tag, count }) => (
        <li>
          <button>
            <a
              href={`/categories/${tag}/`}
              rel="prefetch-intent tag"
              data-umami-event={`categories-${tag}`}
            >
              <span class="label">{tag}</span>
              <span class="count">{count}</span>
            </a>
          </button>
        </li>
      ))
    }
  </ul>
</section>
